{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "driving-rig/take.schema.json",
  "title": "Driving Rig take \u2014 format v2",
  "description": "Columnar take: every channel is a time series (time = last axis), component-major. Usually gzipped (.json.gz). See docs/SCHEMA.md. Cross-field rules (all series length == meta.n, unit quaternions, in_index < out_index < n) are checked by TakeValidator (Godot) and take_io.validate (Python), not by this schema.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "meta",
    "channels"
  ],
  "properties": {
    "format": {
      "const": "driving_rig_take"
    },
    "format_version": {
      "const": 2
    },
    "meta": {
      "type": "object",
      "required": [
        "take",
        "n",
        "tick_hz",
        "unit_scale",
        "up_axis",
        "forward",
        "handles",
        "in_index",
        "out_index",
        "body",
        "wheelbase",
        "track_f",
        "track_r",
        "wheel_radius",
        "wheel_width",
        "susp_rest",
        "susp_max_travel",
        "hardpoints"
      ],
      "properties": {
        "take": {
          "type": "integer"
        },
        "n": {
          "type": "integer",
          "minimum": 2
        },
        "tick_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit_scale": {
          "type": "number"
        },
        "up_axis": {
          "const": "Y"
        },
        "forward": {
          "const": "-Z"
        },
        "collision_source": {
          "type": "string"
        },
        "handles": {
          "type": "integer"
        },
        "handle_ticks": {
          "type": "integer"
        },
        "handle_fps_basis": {
          "type": "number"
        },
        "in_index": {
          "type": "integer",
          "minimum": 0
        },
        "out_index": {
          "type": "integer",
          "minimum": 1
        },
        "body": {
          "type": "object",
          "required": [
            "extents",
            "com_offset"
          ],
          "properties": {
            "extents": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "com_offset": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "mass": {
              "type": "number"
            },
            "extents_are": {
              "const": "full_size"
            }
          }
        },
        "wheelbase": {
          "type": "number"
        },
        "track_f": {
          "type": "number"
        },
        "track_r": {
          "type": "number"
        },
        "wheel_radius": {
          "type": "number"
        },
        "wheel_width": {
          "type": "number"
        },
        "susp_rest": {
          "type": "number"
        },
        "susp_max_travel": {
          "type": "number"
        },
        "hardpoints": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 4,
          "maxItems": 4
        },
        "wheel_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "channel_shapes": {
          "type": "object"
        },
        "conventions": {
          "type": "object"
        },
        "car_params": {
          "type": "object"
        },
        "godot_version": {
          "type": "string"
        },
        "rig_version": {
          "type": "string"
        },
        "created": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "channels": {
      "type": "object",
      "required": [
        "chassis.p",
        "chassis.q",
        "vel",
        "angvel",
        "input.throttle",
        "input.brake",
        "input.steer",
        "input.handbrake",
        "wheels.compression",
        "wheels.steer",
        "wheels.spin_cumulative",
        "wheels.grounded",
        "wheels.contact_p",
        "wheels.contact_n",
        "wheels.slip_long",
        "wheels.slip_lat"
      ],
      "properties": {
        "chassis.p": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "chassis.q": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "vel": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "angvel": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "input.throttle": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "input.brake": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "input.steer": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "input.handbrake": {
          "type": "array",
          "items": {
            "enum": [
              0,
              1
            ]
          }
        },
        "camera.p": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "camera.q": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "camera.fov": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "wheels.compression": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "wheels.steer": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "wheels.spin_cumulative": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "wheels.grounded": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "enum": [
                0,
                1
              ]
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "wheels.contact_p": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 4,
          "maxItems": 4
        },
        "wheels.contact_n": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 4,
          "maxItems": 4
        },
        "wheels.slip_long": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "wheels.slip_lat": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}