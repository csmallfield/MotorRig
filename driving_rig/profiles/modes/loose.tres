[gd_resource type="Resource" script_class="DriveMode" format=3]

[ext_resource type="Script" path="res://scripts/profiles/drive_mode.gd" id="1_kdjbh"]

[resource]
script = ExtResource("1_kdjbh")
display_name = "Loose"
description = "Standard with the leash off: exponential pedals, no ABS or TC, full steering lock at any speed, brakes that lock all four wheels, and a rear you can hang out on the throttle or the handbrake. Still catchable - countersteer and it comes back. For rolling the car, use Stunt."
throttle_gamma = 2.0
brake_gamma = 2.0
steer_gamma = 1.3
steer_rate_scale = 1.8
steer_return_scale = 1.6
steer_grip_margin_deg = 40.0
abs_mode = 2
traction_control_mode = 2
brake_force_scale = 1.7
engine_scale = 1.35
drive_force_scale = 1.4
handbrake_force_scale = 1.6
rear_grip_scale = 0.97
falloff_floor_front_scale = 1.18
falloff_floor_rear_scale = 1.08
falloff_width_scale = 1.4
handbrake_rear_grip_scale = 0.55
kerb_trip = 1.0
