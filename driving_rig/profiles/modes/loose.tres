[gd_resource type="Resource" script_class="DriveMode" format=3]

[ext_resource type="Script" path="res://scripts/profiles/drive_mode.gd" id="1_kdjbh"]

[resource]
script = ExtResource("1_kdjbh")
display_name = "Loose"
description = "Standard with the leash off: exponential pedals, no ABS or TC, unlimited steering, brakes that lock, and a rear that steps out. Drift, donut and spin it; lean hard enough to lift the inside wheels, and trip into a roll over a kerb or a crest."
throttle_gamma = 2.0
brake_gamma = 2.0
steer_gamma = 1.6
steer_rate_scale = 2.0
steer_return_scale = 1.6
steer_grip_margin_deg = 40.0
abs_mode = 2
traction_control_mode = 2
low_speed_hold = false
brake_force_scale = 2.6
engine_scale = 1.35
drive_force_scale = 1.5
handbrake_force_scale = 1.6
rear_grip_scale = 0.78
falloff_floor_scale = 0.78
handbrake_rear_grip_scale = 0.55
com_raise = 0.2
kerb_trip = 1.0
