[gd_resource type="Resource" script_class="DriveMode" format=3]

[ext_resource type="Script" path="res://scripts/profiles/drive_mode.gd" id="1_k520d"]

[resource]
script = ExtResource("1_k520d")
display_name = "Drift"
description = "Loose with more power and a rear that lets go a little earlier and stays out longer. Flick it with the handbrake or lift, then hold the angle on the throttle and countersteer."
throttle_gamma = 1.7
brake_gamma = 2.0
steer_gamma = 1.2
steer_rate_scale = 2.2
steer_return_scale = 2.0
steer_grip_margin_deg = 40.0
abs_mode = 2
traction_control_mode = 2
brake_force_scale = 1.7
engine_scale = 1.6
drive_force_scale = 1.6
handbrake_force_scale = 1.8
rear_grip_scale = 0.9
falloff_floor_front_scale = 1.2
falloff_floor_rear_scale = 0.98
falloff_width_scale = 1.6
handbrake_rear_grip_scale = 0.45
kerb_trip = 1.0
