[resource]
script = ExtResource("1_xl1o0")
display_name = "Stunt"
description = "Loose, but deliberately top-heavy: hold a hard corner at the grip limit and it will go over. For rolls, barrel rolls off the ramp and wrecks. Not for takes you want to look sane."
