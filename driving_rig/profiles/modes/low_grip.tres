[ext_resource type="Script" path="res://scripts/profiles/drive_mode.gd" id="1_ld0b5"]

[resource]
script = ExtResource("1_ld0b5")
display_name = "Low Grip"
description = "Loose on a wet road: about three quarters of the grip, so it takes longer to slow, turn and stop. Pair with the Wet Hills world for less again."
throttle_gamma = 2.0
brake_gamma = 2.0
steer_gamma = 1.3
steer_rate_scale = 2.0
steer_grip_margin_deg = 40.0
abs_mode = 2
traction_control_mode = 2
brake_force_scale = 1.5
tire_mu_scale = 0.78
falloff_floor_front_scale = 1.18
falloff_floor_rear_scale = 1.1
falloff_width_scale = 1.5
kerb_trip = 1.0
