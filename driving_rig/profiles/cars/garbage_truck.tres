script = ExtResource("1_urh1u")
display_name = "Garbage Truck"
description = "16 t of front-engine refuse truck: short wheelbase for its size, very tall and nose-heavy. Big brakes, no speed, and it will flatten a hydrant. Corner it hard and it goes over - its centre of mass is above what the tyres can hold (SSF 0.89 vs 0.95 grip)."
